{
  "name": "mcp-server-vscode",
  "displayName": "MCP Server for VS Code (solf)",
  "description": "VS Code extension that provides an MCP server for AI assistants to interact with your development environment",
  "version": "0.3.0",
  "publisher": "solf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/solf/mcp-server-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/solf/mcp-server-vscode/issues"
  },
  "homepage": "https://github.com/solf/mcp-server-vscode#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vscode",
    "language-server",
    "debugging",
    "ai-assistant",
    "claude",
    "claude-desktop",
    "claude-code",
    "anthropic"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-mcp.startServer",
        "title": "Start MCP Server"
      },
      {
        "command": "vscode-mcp.stopServer",
        "title": "Stop MCP Server"
      },
      {
        "command": "vscode-mcp.toggleServer",
        "title": "Toggle MCP Server"
      }
    ],
    "configuration": {
      "title": "VS Code MCP Server",
      "properties": {
        "vscode-mcp.port": {
          "type": "number",
          "default": 0,
          "description": "Port for the MCP server. 0 (the default) lets the OS pick a free one, so every window gets its own and clients find it through the discovery registry. Set a specific port only if you need a fixed one -- startup then fails if that port is already taken, rather than quietly using a different one."
        },
        "vscode-mcp.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the MCP server automatically when the window opens. Disable to start it manually from the status bar."
        }
      }
    }
  },
  "bin": {
    "mcp-server-vscode": "./out/mcp/standalone-server.js"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "rm -rf out",
    "compile": "node scripts/gen-build-info.js && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepare": "npm run compile",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "deploy:client": "node scripts/deploy-client.js",
    "start:mcp": "node ./out/mcp/standalone-server.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^8.57.1",
    "glob": "^11.0.3",
    "mocha": "^11.7.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
